# serverend — HTTP API + Discord Bot
PORT=3000

# Discord OAuth2 (Web admin login)
# Create an application at https://discord.com/developers/applications
CLIENT_ID=
CLIENT_SECRET=
# Must match a Redirect URI registered in the Discord app.
# Local dev (Vite): http://localhost:5174/auth/redirect
# Docker / single-port production: http://localhost:3000/auth/redirect
REDIRECT_URI=http://localhost:5174/auth/redirect

# First admin: Discord user ID allowed to log in before any admin is registered.
ADMIN_USER_ID=

# Discord Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Target guild (single-guild setup)
DISCORD_GUILD_ID=

# Session lifetime (e.g. 14d, 7d, 12h)
SESSION_EXPIRES_IN=14d

# Optional: OpenAI Moderation API for message/profile filters
OPENAI_API_KEY=

# --- Static frontend (optional override) ---
# Production (node dist): enabled automatically when frontend/dist exists.
# Development (tsx): disabled automatically — use Vite on :5174 instead.
# SERVE_STATIC=false
